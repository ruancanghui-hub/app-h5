#!/usr/bin/expect -f
# SCP 密码上传封装
#
# 用法: SSH_PW='password' expect scp-pass.exp <local> <host> <remote>
#
# 环境变量:
#   SSH_PW    必填，登录密码
#   SSH_BIND  可选，绑定本机源地址以绕过 TUN 模式代理（见 ssh-pass.exp 说明）

set timeout 300
log_user 1

if {![info exists env(SSH_PW)]} { puts stderr "ERROR: 缺少 SSH_PW"; exit 1 }

set local  [lindex $argv 0]
set host   [lindex $argv 1]
set remote [lindex $argv 2]
if {$local eq "" || $host eq "" || $remote eq ""} {
    puts stderr "用法: SSH_PW='...' expect scp-pass.exp <local> <host> <remote>"
    exit 1
}
set pw   $env(SSH_PW)
set bind [expr {[info exists env(SSH_BIND)] ? $env(SSH_BIND) : ""}]

if {$bind ne ""} {
    spawn scp -r -o BindAddress=$bind \
              -o StrictHostKeyChecking=accept-new \
              -o ConnectTimeout=20 \
              -o PubkeyAuthentication=no \
              -o PreferredAuthentications=password,keyboard-interactive \
              $local $host:$remote
} else {
    spawn scp -r -o StrictHostKeyChecking=accept-new \
              -o ConnectTimeout=20 \
              -o PubkeyAuthentication=no \
              -o PreferredAuthentications=password,keyboard-interactive \
              $local $host:$remote
}

expect {
    -re "(?i)are you sure you want to continue connecting" { send "yes\r"; exp_continue }
    -re "(?i)password:"                                    { send "$pw\r"; exp_continue }
    -re "(?i)permission denied"                            { puts stderr "\n[AUTH_FAILED]"; exit 5 }
    eof
}
catch wait result
exit [lindex $result 3]
